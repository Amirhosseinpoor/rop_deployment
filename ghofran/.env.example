# Copy to `.env` and fill in. docker compose reads this file automatically.
# Leave optional keys blank to disable the feature that needs them.

# === USAC (required) ============================================================
# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
USAC_JWT_SECRET=

# === Doctors-Marketplace ========================================================
# Admin key required by the /studio/* endpoints (leave blank to disable studio).
DM_STUDIO_API_KEY=
# OpenAI-compatible credentials for chat replies (shared with rag_api below).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
DM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === ROP-RAG (rag_api) ==========================================================
RAG_LLM_MODEL=gpt-4o-mini
RAG_EMBEDDINGS_MODEL=nomic-embed-text:latest
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional web RAG (leave blank to use local RAG only).
SERPER_API_KEY=

# === Test-Analysis (health) =====================================================
# Chat assistant LLM (GapGPT / OpenAI-compatible).
GAPGPT_API_KEY=
GAPGPT_BASE_URL=
GAPGPT_MODEL=gpt-5-nano
# Report pipeline LLM (Metis / OpenAI-compatible).
METIS_API_KEY=
METIS_BASE_URL=
METIS_MODEL=gpt-4o-mini
HEALTH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
